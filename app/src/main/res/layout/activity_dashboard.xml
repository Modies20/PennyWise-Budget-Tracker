<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="#4CAF50" android:title="PennyWise" android:titleTextColor="@android:color/white"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="16dp">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/tvWelcome" android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:text="Monthly Budget Progress" android:textStyle="bold" android:layout_marginTop="16dp"/>
            <ProgressBar android:id="@+id/pbBudget" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="20dp" android:max="100"/>
            <TextView android:id="@+id/tvBudgetStatus" android:layout_marginBottom="16dp"/>
            <Button android:id="@+id/btnSetBudget" android:text="Set Monthly Budget" android:layout_marginTop="8dp"/>
            <Button android:id="@+id/btnManageCategories" android:text="Manage Categories" android:layout_marginTop="8dp"/>
            <Button android:id="@+id/btnAddExpense" android:text="Add Expense" android:layout_marginTop="8dp"/>
            <Button android:id="@+id/btnViewExpenses" android:text="View Expenses" android:layout_marginTop="8dp"/>
            <Button android:id="@+id/btnCategoryTotals" android:text="Category Totals" android:layout_marginTop="8dp"/>
            <Button android:id="@+id/btnLogout" android:text="Logout" android:backgroundTint="#F44336" android:layout_marginTop="16dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>