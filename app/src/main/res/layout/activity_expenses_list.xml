<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <Button android:id="@+id/btnStartDate" android:text="Start Date" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    <Button android:id="@+id/btnEndDate" android:text="End Date" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    <Button android:id="@+id/btnFilter" android:text="Filter" android:backgroundTint="#4CAF50" android:layout_marginTop="8dp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvExpenses"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="16dp"/>
</LinearLayout>