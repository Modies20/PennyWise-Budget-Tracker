<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:text="Min Spending Goal Compliance" android:textSize="18sp" android:textStyle="bold"/>
    <ProgressBar android:id="@+id/progressMin" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="20dp" android:max="100"/>
    <TextView android:id="@+id/tvMinScore" android:layout_marginBottom="24dp"/>
    <TextView android:text="Max Spending Goal Compliance" android:textSize="18sp" android:textStyle="bold"/>
    <ProgressBar android:id="@+id/progressMax" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="20dp" android:max="100"/>
    <TextView android:id="@+id/tvMaxScore"/>
    <ImageView android:id="@+id/ivMinSmiley" android:layout_width="80dp" android:layout_height="80dp"
        android:layout_marginTop="32dp" android:src="@drawable/ic_happy"/>
</LinearLayout>