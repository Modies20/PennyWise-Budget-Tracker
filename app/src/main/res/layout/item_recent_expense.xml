<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:padding="12dp" android:background="?android:attr/selectableItemBackground">
    <TextView android:id="@+id/tvCategory" android:textSize="16sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tvDescription" android:textSize="14sp"/>
    <TextView android:id="@+id/tvAmount" android:textSize="14sp" android:textColor="#4CAF50"/>
    <TextView android:id="@+id/tvDate" android:textSize="12sp" android:textColor="@android:color/darker_gray"/>
    <ImageView android:id="@+id/ivReceiptThumb" android:layout_width="50dp" android:layout_height="50dp"
        android:layout_marginTop="4dp" android:visibility="gone"/>
</LinearLayout>